{
  "opencollection": "1.0.0",
  "info": {
    "name": "Postman API (Test Suites) Collections Workspaces API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workspaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workspaces containing collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getpostman.com/workspaces"
          },
          "docs": "List workspaces containing collections"
        },
        {
          "info": {
            "name": "Get a workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getpostman.com/workspaces/:workspace_id",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a workspace"
        }
      ]
    }
  ],
  "bundled": true
}